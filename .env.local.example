# Copie para .env.local e preencha com as chaves do projeto Supabase
# Projeto: zlzgkivktvnyvehjwcjw
# Nunca commite .env.local com secrets reais.

SUPABASE_URL=https://zlzgkivktvnyvehjwcjw.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://zlzgkivktvnyvehjwcjw.supabase.co

SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
# Compatibilidade opcional
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key-here

SUPABASE_SECRET_KEY=your-secret-key-here

SUPABASE_JWKS_URL=https://zlzgkivktvnyvehjwcjw.supabase.co/auth/v1/.well-known/jwks.json

# Personal Access Token (Account → Access Tokens) — Management API / DDL
# SUPABASE_ACCESS_TOKEN=sbp_your-access-token-here

# OpenRouter — gateway IA (preferencial; nunca commit a key)
OPENROUTER_API_KEY=
# OPENROUTER_STORY_MODEL=deepseek/deepseek-v4-pro
# OPENROUTER_STORY_AUX_MODEL=google/gemini-2.5-flash
# OPENROUTER_STORY_PAGE_DIRECTOR_MODEL=google/gemini-2.5-flash
# OPENROUTER_IMAGE_MODEL=openai/gpt-image-2
# OPENROUTER_IMAGE_QUALITY=low
# OPENROUTER_HTTP_REFERER=http://127.0.0.1:5050
# OPENROUTER_APP_TITLE=Euzim

# Fallback temporário OpenAI direto (só se OPENROUTER_API_KEY ausente)
# OPENAI_API_KEY=
# OPENAI_STORY_MODEL=gpt-4o
# OPENAI_STORY_AUX_MODEL=gpt-4o-mini
# OPENAI_IMAGE_MODEL=gpt-image-2
# OPENAI_IMAGE_QUALITY=low

# Cotação usada no painel admin de custos (default 5.70)
# USD_BRL_RATE=5.70

# Stripe LIVE (produção / catálogo fonte do espelho)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe TEST (local :5050 — não substitui as live)
# STRIPE_SECRET_KEY_TEST=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY_TEST=pk_test_...
# STRIPE_WEBHOOK_SECRET_TEST=whsec_...   # via: stripe listen --forward-to localhost:5050/api/stripe/webhook
# APP_ENV=local
# STRIPE_MODE=test   # override opcional (test|live)

# NEXT_PUBLIC_APP_URL=http://127.0.0.1:5050

